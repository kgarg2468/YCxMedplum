# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Medplum — create a ClientApplication in the Medplum console, then copy both values.
# Hosted: https://api.medplum.com  |  Local docker: http://localhost:8103
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Voice platform (whichever you pick — Vapi and Retell are fastest to a working call)
VAPI_API_KEY=
RETELL_API_KEY=
DEEPGRAM_API_KEY=

# Moss — real-time semantic search runtime. Create a project at https://portal.usemoss.dev
# Also read by .mcp.json (Moss MCP server) and by the moss CLI (`pip install moss-cli`).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
