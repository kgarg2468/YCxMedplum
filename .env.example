# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Medplum — create a ClientApplication in the Medplum console, then copy both values.
# Hosted: https://api.medplum.com  |  Local docker: http://localhost:8103
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Vapi — the call orchestrator. Deepgram Nova-3 (STT) and Aura (TTS) are used
# through Vapi; there is no direct Deepgram integration.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# ID of the Vapi Bearer Token Custom Credential whose secret equals
# VAPI_WEBHOOK_SECRET below. Only the ID goes here — never the secret.
VAPI_SERVER_CREDENTIAL_ID=
# Bearer token the server requires on POST /vapi. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAPI_WEBHOOK_SECRET=

# Bearer token for the operator-only POST /demo/start-call on 127.0.0.1.
DEMO_START_SECRET=
# E.164 number the demo call dials, e.g. +15550100. Never commit a real number.
DEMO_CUSTOMER_NUMBER=
# Local review panel + start route. The tunnelled webhook stays on PORT (3000).
REVIEW_PORT=3001
